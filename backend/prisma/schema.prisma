// This is your Prisma schema file
// Member 5 is the SOLE maintainer of this file
// Run: npx prisma migrate dev --name <description> after any changes
// DO NOT modify this file without notifying Member 5 first

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Member 1 — 用户系统
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  username     String   @unique
  display_name String?
  avatar_url   String?
  bio          String?
  role         Role     @default(user)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  cats                     Cat[]
  posts                    Post[]
  post_likes               PostLike[]
  comments                 Comment[]
  adopter_preferences      AdopterPreference?
  adoption_applications    AdoptionApplication[]
  adoption_swipes          AdoptionSwipe[]         // 领养推荐滑动记录（Member 2）
  owner_health_records     OwnerHealthRecord[]     // 该用户记录的猫咪健康档案
  health_share_permissions HealthSharePermission[] // 该用户授权给诊所的健康数据权限
  followers                UserFollow[]            @relation("following")
  following                UserFollow[]            @relation("follower")
  conversations_as_user    Conversation[]          @relation("user_conversations")
  conversations_as_org     Conversation[]          @relation("org_conversations")
  sent_messages            Message[]
  reviewed_applications    AdoptionApplication[]   @relation("reviewer")
  notification_reads       NotificationRead[]      // 通知已读记录

  @@map("users")
}

enum Role {
  user
  rescue_staff
  clinic_staff
  admin
}

// ─────────────────────────────────────────
// Member 3 — 关注关系 & 通知
// ─────────────────────────────────────────

model UserFollow {
  id            String   @id @default(uuid())
  follower_id   String
  following_id  String
  created_at    DateTime @default(now())

  follower  User @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@map("user_follows")
}

model NotificationRead {
  user_id         String
  notification_id String
  read_at         DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, notification_id])
  @@map("notification_reads")
}

// ─────────────────────────────────────────
// Member 5 — 救助机构 / 诊所 / 健康管理
// ─────────────────────────────────────────

model Organization {
  id             String   @id @default(uuid())
  name           String
  type           OrgType
  email          String   @unique
  password       String
  phone          String?
  address        String?
  logo_url       String?
  description    String?
  license_number String?
  is_verified    Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  cats            Cat[]
  clinic_reports  ClinicHealthReport[]
  adoption_events AdoptionEvent[]

  @@map("organizations")
}

enum OrgType {
  rescue
  clinic
}

model AdoptionEvent {
  id          String    @id @default(uuid())
  name        String
  edition     Int?
  start_date  DateTime
  end_date    DateTime?
  location    String?
  description String?
  org_id      String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  organization Organization?       @relation(fields: [org_id], references: [id])
  cats         Cat[]
  applications AdoptionApplication[]

  @@map("adoption_events")
}

// ─────────────────────────────────────────
// Member 2 — 猫咪档案 + 领养模块
// Member 4 — 猫脸识别特征表
// ─────────────────────────────────────────

model Cat {
  id            String      @id @default(uuid())
  name          String
  breed         String?
  age_months    Int?
  gender        CatGender?
  color         String?
  description   String?
  photo_url     String?
  status        CatStatus   @default(available)
  is_neutered   Boolean?
  is_vaccinated Boolean?
  is_dewormed   Boolean?
  intake_date      DateTime?
  found_location   String?
  owner_id      String?
  org_id        String?
  event_id      String?
  face_code     String?     @unique  // 猫脸识别编号，如 "CF-2026-00042"
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  owner                    User?
  organization             Organization?
  event                    AdoptionEvent?
  tags                     CatTag[]
  requirements             CatRequirement[]
  updates                  CatUpdate[]
  adoption_applications    AdoptionApplication[]
  adoption_swipes          AdoptionSwipe[]         // 用户对该猫的滑动记录
  owner_health_records     OwnerHealthRecord[]
  clinic_reports           ClinicHealthReport[]
  health_share_permissions HealthSharePermission[]
  face_embedding           CatFaceEmbedding?       // 猫脸特征向量（一对一）

  @@map("cats")
}

model CatFaceEmbedding {
  id            String   @id @default(uuid())
  cat_id        String   @unique
  embedding     Json
  model_version String   @default("v1.0")
  source_image_url String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  cat Cat @relation(fields: [cat_id], references: [id], onDelete: Cascade)

  @@map("cat_face_embeddings")
}

enum CatGender {
  male
  female
  unknown
}

enum CatStatus {
  available
  adopted
  fostered
  deceased
}

model CatTag {
  id         String   @id @default(uuid())
  cat_id     String
  tag        String
  created_at DateTime @default(now())

  cat Cat @relation(fields: [cat_id], references: [id], onDelete: Cascade)

  @@map("cat_tags")
}

model CatRequirement {
  id          String   @id @default(uuid())
  cat_id      String
  description String
  created_at  DateTime @default(now())

  cat Cat @relation(fields: [cat_id], references: [id], onDelete: Cascade)

  @@map("cat_requirements")
}

model CatUpdate {
  id         String   @id @default(uuid())
  cat_id     String
  content    String
  photo_url  String?
  created_at DateTime @default(now())

  cat Cat @relation(fields: [cat_id], references: [id], onDelete: Cascade)

  @@map("cat_updates")
}

model AdopterPreference {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  preferred_age       String?
  preferred_gender    String?
  preferred_breed     String?
  preferred_color     String?  // 偏好毛色，如 "orange"、"black"、"calico"
  accept_special_need Boolean?
  home_type           String?
  has_other_pets      Boolean?
  has_children        Boolean?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("adopter_preferences")
}

model AdoptionApplication {
  id          String            @id @default(uuid())
  user_id     String
  cat_id      String
  event_id    String?
  status      ApplicationStatus @default(pending)
  message     String?
  reviewed_by String?
  reviewed_at DateTime?
  reject_note String?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cat      Cat            @relation(fields: [cat_id], references: [id], onDelete: Cascade)
  event    AdoptionEvent? @relation(fields: [event_id], references: [id])
  reviewer User?          @relation("reviewer", fields: [reviewed_by], references: [id])

  @@map("adoption_applications")
}

model AdoptionSwipe {
  id         String   @id @default(uuid())
  user_id    String
  cat_id     String
  liked      Boolean
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cat  Cat  @relation(fields: [cat_id], references: [id], onDelete: Cascade)

  @@unique([user_id, cat_id])
  @@map("adoption_swipes")
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

// ─────────────────────────────────────────
// Member 3 — 社区模块
// ─────────────────────────────────────────

model Post {
  id         String   @id @default(uuid())
  user_id    String
  content    String
  image_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments Comment[]

  @@map("posts")
}

model PostLike {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@map("post_likes")
}

model Comment {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  content    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─────────────────────────────────────────
// Member 5 — 健康管理模块
// ─────────────────────────────────────────

model OwnerHealthRecord {
  id            String           @id @default(uuid())
  cat_id        String
  user_id       String
  record_type   HealthRecordType
  description   String
  date          DateTime
  next_due_date DateTime?
  weight_kg     Float?
  vet_name      String?
  clinic_name   String?
  file_url      String?          // 附件 URL（图片或 PDF），由上传接口返回后填入
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  cat  Cat  @relation(fields: [cat_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("owner_health_records")
}

enum HealthRecordType {
  vaccine
  deworming
  checkup
  treatment
  surgery
  other
}

model ClinicHealthReport {
  id          String           @id @default(uuid())
  cat_id      String
  org_id      String
  report_type ClinicReportType
  description String
  file_url    String?
  date        DateTime
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  cat          Cat          @relation(fields: [cat_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("clinic_health_reports")
}

enum ClinicReportType {
  vaccination
  deworming
  checkup
  blood_test
  treatment
  surgery
  other
}

model HealthSharePermission {
  id         String   @id @default(uuid())
  cat_id     String
  user_id    String
  org_id     String
  is_allowed Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cat  Cat  @relation(fields: [cat_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([cat_id, org_id])
  @@map("health_share_permissions")
}

// ─────────────────────────────────────────
// Member 6 — 聊天功能
// ─────────────────────────────────────────

model Conversation {
  id         String   @id @default(uuid())
  user_id    String
  org_id     String
  created_at DateTime @default(now())

  user     User      @relation("user_conversations", fields: [user_id], references: [id], onDelete: Cascade)
  org      User      @relation("org_conversations", fields: [org_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user_id, org_id])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  created_at      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  message_id String
  file_url   String
  file_type  String
  created_at DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}
